#!/bin/sh
# Fake `getprop` for local testing: reads the two properties the daemon
# actually uses from environment variables, so tests can simulate a SIM
# change without any real Android device.
#   MOCK_SIM_OPERATOR   -> gsm.sim.operator.numeric   (default: 43408)
#   MOCK_SIM_ISROAMING  -> gsm.operator.isroaming     (default: false,false)

case "$1" in
    gsm.sim.operator.numeric)
        echo "${MOCK_SIM_OPERATOR:-43408}"
        ;;
    gsm.operator.isroaming)
        echo "${MOCK_SIM_ISROAMING:-false,false}"
        ;;
    *)
        echo ""
        ;;
esac
